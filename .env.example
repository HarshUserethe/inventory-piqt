# Resend API key - create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. The domain must be verified in Resend.
# For local testing without a verified domain, keep onboarding@resend.dev.
RESEND_FROM_EMAIL="Process IQ Tech Careers <careers@your-verified-domain.com>"

# Recruiter inbox that receives every application with the resume attached.
CAREERS_EMAIL=careers@processiqtechconsulting.com

# Team inbox that receives every contact-us inquiry.
CONTACT_EMAIL=support@processiqtechconsulting.com
